# ชื่อโปรแกรมที่เราจะสร้าง (ตามที่โจทย์กำหนด)
NAME = rush-02

# คอมไพเลอร์และแฟล็กที่โจทย์กำหนด (ห้ามขาดแม้แต่ตัวเดียว)
CC = cc
CFLAGS = -Wall -Wextra -Werror

# รายชื่อไฟล์ (Source Files) ทั้งหมดตามที่แบ่งไว้
SRCS = main.c \
       validate.c \
# 	   parse_dict.c \
# 	   logic.c \
# 	   utils.c \
# 	   free_mem.c

# เปลี่ยนชื่อไฟล์ .c ให้เป็น .o (Object Files) ตอนคอมไพล์
OBJS = $(SRCS:.c=.o)

# กฎข้อที่ 1: กฎหลักในการสร้างโปรแกรม (สั่งพิมพ์ 'make' เฉยๆ จะวิ่งมาทำตรงนี้)
all: $(NAME)

# วิธีการประกอบไฟล์ .o ทั้งหมดให้กลายเป็นโปรแกรมตัวเต็ม
$(NAME): $(OBJS)
	$(CC) $(CFLAGS) -o $(NAME) $(OBJS)

# วิธีการเปลี่ยนไฟล์ .c แต่ละไฟล์ให้กลายเป็น .o
%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

# กฎข้อที่ 2: ลบไฟล์พวก .o ออกไปเพื่อเคลียร์พื้นที่
clean:
	rm -f $(OBJS)

# กฎข้อที่ 3: ลบทั้งไฟล์ .o และตัวโปรแกรมรันหลักออกไปจนเกลี้ยง (ตามที่โจทย์จะใช้ตรวจ)
fclean: clean
	rm -f $(NAME)

# กฎข้อที่ 4: เคลียร์ระบบแล้วคอมไพล์ใหม่ทั้งหมดตั้งแต่ศูนย์
re: fclean all

# .PHONY มีไว้เพื่อป้องกันไม่ให้ชื่อกฎไปซ้ำกับชื่อไฟล์จริงในโฟลเดอร์ (ช่วยให้ Makefile ปลอดภัยขึ้น)
.PHONY: all clean fclean re